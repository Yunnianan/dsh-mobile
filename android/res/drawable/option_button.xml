<?xml version="1.0" encoding="utf-8"?>
<!-- Selection state for the segmented option buttons (font size, theme). A single
     color is used for both states through the theme's colorAccent, so the selected
     option reads as filled while the others stay flat. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#33000000" />
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="?android:attr/colorAccent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#40808080" />
        </shape>
    </item>
</selector>
